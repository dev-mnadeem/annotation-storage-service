            "url": {
              "raw": "{{baseUrl}}/images/{{imageId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "images",
                "{{imageId}}"
              ]
            }
          }
        },
        {
          "name": "Every mask on an image, ranked",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{annotatorKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/images/{{imageId}}/masks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "images",
                "{{imageId}}",
                "masks"
              ]
            }
          }
        },
        {
          "name": "Reopen an annotated image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{annotatorKey}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/images/{{imageId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "images",
                "{{imageId}}",
                "status"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"reopen\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Projects",
      "item": [
        {
          "name": "Get a project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
