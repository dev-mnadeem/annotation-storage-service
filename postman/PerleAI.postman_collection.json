              }
            ],
            "url": {
              "raw": "{{baseUrl}}/projects/{{projectId}}/stats",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "projects",
                "{{projectId}}",
                "stats"
              ]
            }
          }
        },
        {
          "name": "Export as COCO",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
