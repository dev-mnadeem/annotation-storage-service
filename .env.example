# Port the API listens on.
PORT=7331

# MongoDB connection string. With docker compose this is the service name:
#   mongodb://mongo:27017/perleai
# Against Atlas it is the SRV string from the cluster's Connect dialog.
MONGODB_URI=mongodb://127.0.0.1:7332/perleai

# Bootstrap admin key, at least 16 characters. Send it as the X-API-Key header.
# It is the only identity that exists before any user row does: use it to create the
# first annotator, then use that annotator's key for day-to-day work.
ADMIN_API_KEY=replace-this-with-a-long-random-string

# Morgan request log format: dev, combined, or off.
REQUEST_LOG=dev
