{
  "info": {
    "name": "PerleAI Segmentation API",
    "description": "Every route the Express router registers, with the status each one returns. Set {{apiKey}} to ADMIN_API_KEY to run the whole collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7331/api"
    },
    {
      "key": "apiKey",
      "value": "change-me-in-dev-only"
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "imageId",
      "value": ""
    },
    {
      "key": "annotationId",
      "value": ""
    },
    {
      "key": "annotatorId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "The only route that answers without a key. Returns 503 while Mongo is unreachable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200) });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "POST /users (admin issues an annotator key)",
          "request": {
            "method": "POST",
